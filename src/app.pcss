/* Tailwind v4 */
@import "tailwindcss/index.css";

/* Class-based dark mode (toggle via .dark on <html>) */
@custom-variant dark (&:where(.dark, .dark *));

/* Tailwind plugins (v4 CSS syntax) */
@plugin "@tailwindcss/forms";
@plugin "@tailwindcss/typography";

/* Custom theme: Cerberus-derived color palette for Tailwind utilities */
@theme {
	--font-family-sans: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
		"Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;

	--color-primary-400: oklch(0.63 0.19 255.71);
	--color-primary-500: oklch(0.57 0.21 258.29);
	--color-primary-600: oklch(0.52 0.19 258.15);
	--color-secondary-500: oklch(0.49 0.23 300.45);
	--color-tertiary-300: oklch(0.7 0.23 350.67);
	--color-tertiary-500: oklch(0.65 0.26 2.47);
	--color-error-500: oklch(0.64 0.22 28.71);
	--color-surface-200: oklch(0.81 0 0);
	--color-surface-800: oklch(0.32 0 0);
	--color-surface-950: oklch(0.18 0 0);

	--radius: 0.5rem;
}

/* shadcn-svelte theme variables */
@layer base {
	:root {
		--background: oklch(0.99 0 0);
		--foreground: oklch(0.18 0 0);
		--card: oklch(0.99 0 0);
		--card-foreground: oklch(0.18 0 0);
		--popover: oklch(0.99 0 0);
		--popover-foreground: oklch(0.18 0 0);
		--primary: oklch(0.57 0.21 258.29);
		--primary-foreground: oklch(0.95 0.02 257);
		--secondary: oklch(0.49 0.23 300.45);
		--secondary-foreground: oklch(0.92 0.03 300);
		--muted: oklch(0.92 0 0);
		--muted-foreground: oklch(0.56 0 0);
		--accent: oklch(0.92 0 0);
		--accent-foreground: oklch(0.18 0 0);
		--destructive: oklch(0.64 0.22 28.71);
		--destructive-foreground: oklch(0.95 0.02 14);
		--border: oklch(0.88 0 0);
		--input: oklch(0.88 0 0);
		--ring: oklch(0.57 0.21 258.29);
	}

	.dark {
		--background: oklch(0.18 0 0);
		--foreground: oklch(0.99 0 0);
		--card: oklch(0.25 0 0);
		--card-foreground: oklch(0.99 0 0);
		--popover: oklch(0.25 0 0);
		--popover-foreground: oklch(0.99 0 0);
		--primary: oklch(0.57 0.21 258.29);
		--primary-foreground: oklch(0.95 0.02 257);
		--secondary: oklch(0.49 0.23 300.45);
		--secondary-foreground: oklch(0.92 0.03 300);
		--muted: oklch(0.32 0 0);
		--muted-foreground: oklch(0.62 0 0);
		--accent: oklch(0.32 0 0);
		--accent-foreground: oklch(0.99 0 0);
		--destructive: oklch(0.64 0.22 28.71);
		--destructive-foreground: oklch(0.95 0.02 14);
		--border: oklch(0.32 0 0);
		--input: oklch(0.32 0 0);
		--ring: oklch(0.57 0.21 258.29);
	}
}

html,
body {
	@apply h-full overflow-hidden;
}

body {
	background-color: var(--background);
	color: var(--foreground);
	background-image: radial-gradient(
			at 0% 0%,
			color-mix(in oklab, var(--color-secondary-500) 33%, transparent) 0px,
			transparent 50%
		),
		radial-gradient(
			at 98% 1%,
			color-mix(in oklab, var(--color-primary-500) 33%, transparent) 0px,
			transparent 50%
		);
	background-attachment: fixed;
	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;
}

.markdown h1,
.markdown h2,
.markdown h3,
.markdown h4,
.markdown h5,
.markdown h6,
.markdown hr,
.markdown p,
.markdown pre,
.markdown ul,
.markdown ol {
	width: 100%;
}
