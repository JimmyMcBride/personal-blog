/* Tailwind v4 */
@import "tailwindcss";

/* Class-based dark mode (toggle via .dark on <html>) */
@custom-variant dark (&:where(.dark, .dark *));

/* Skeleton v4 */
@import "@skeletonlabs/skeleton";
@import "@skeletonlabs/skeleton-svelte";
@import "@skeletonlabs/skeleton/themes/cerberus";

/* Tailwind plugins (v4 CSS syntax) */
@plugin "@tailwindcss/forms";
@plugin "@tailwindcss/typography";

/* Custom theme overrides */
@theme {
	--font-family-sans: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
		"Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
}

html,
body {
	@apply h-full overflow-hidden;
}

body {
	background-image: radial-gradient(
			at 0% 0%,
			color-mix(in oklab, var(--color-secondary-500) 33%, transparent) 0px,
			transparent 50%
		),
		radial-gradient(
			at 98% 1%,
			color-mix(in oklab, var(--color-primary-500) 33%, transparent) 0px,
			transparent 50%
		);
	background-attachment: fixed;
	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;
}

.markdown h1,
.markdown h2,
.markdown h3,
.markdown h4,
.markdown h5,
.markdown h6,
.markdown hr,
.markdown p,
.markdown pre {
	width: 100%;
}
